{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "athleon",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "athleon"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "SITE_URL": "https://athleon.harishmenon4571.workers.dev",
    "ONBOARDING_FROM_EMAIL": "AthleOn <onboarding@athleon.club>"
  },
  "observability": {
    "enabled": true
  }
}
